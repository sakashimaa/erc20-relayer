{
  "name": "erc20-relayer",
  "version": "1.0.0",
  "description": "This project is a REST API server which accepts requests to transfer some tokens, saving it to PostgreSQL. Worker is queueing requests, signing transactions from hot service wallet and sending them into Sepolia",
  "main": "index.js",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sakashimaa/erc20-relayer.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/sakashimaa/erc20-relayer/issues"
  },
  "homepage": "https://github.com/sakashimaa/erc20-relayer#readme",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "viem": "^2.56.8",
    "zod": "^4.6.5",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.1",
    "@types/pino": "^7.0.4",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
